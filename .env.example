# Solana RPC. The public endpoint works for wallet tracking; a provider key is needed for --holders-of.
RPC_URL=https://api.mainnet-beta.solana.com
# WebSocket endpoint. Left empty, it is derived from RPC_URL (https → wss).
WS_URL=
# Requests per second for transaction lookups. Public endpoints throttle bursts.
RPC_MAX_RPS=2

# Wallets to watch: a JSON file like wallets.example.json
WALLETS_FILE=wallets.json
# Alert only on trades of at least this many SOL
MIN_SOL=0.1

# Optional: Telegram alerts (bot from @BotFather + your chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: append every alert as one JSON line to this file
ALERTS_JSONL=
